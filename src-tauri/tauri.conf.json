{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltraDM",
  "version": "1.1.12",
  "identifier": "com.ultradm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UltraDM",
        "label": "main",
        "width": 1180,
        "height": 740,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/ultradm/UltraDM/releases/latest/downloads/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../browser-extension/": "browser-extension/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "./icons/installer.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
